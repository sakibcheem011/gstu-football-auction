generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id              String  @id @default(cuid())
  name            String
  email           String  @unique
  passwordHash    String
  role            Role
  phone           String? @unique
  desiredTeamName String?
  isApproved      Boolean @default(true)
  team            Team?
}

model SystemConfig {
  id            String  @id @default("singleton")
  currentPhase  Phase   @default(SETUP)
  totalBudget   Int
  minRosterSize Int
  defaultTimer  Int     @default(60)
  maxRosterSize Int     @default(18)
  timerLocked   Boolean @default(false)
}

model Session {
  id     String  @id @default(cuid())
  name   String
  active Boolean @default(true)
}

model PlayerCategory {
  id        String   @id @default(cuid())
  name      String
  basePrice Int
  players   Player[]
}

model BiddingRaiseTier {
  id       String @id @default(cuid())
  minPct   Float
  maxPct   Float
  raisePct Float
}

model Team {
  id              String   @id @default(cuid())
  name            String
  logoUrl         String?
  logoPublicId    String?
  managerId       String?  @unique
  remainingBudget Int
  players         Player[]
  manager         User?    @relation(fields: [managerId], references: [id])
  wishlistPlayers Player[] @relation("TeamWishlist")
}

model Player {
  id                String           @id @default(cuid())
  name              String
  studentId         String           @unique
  sessionId         String
  jerseyName        String
  imageUrl          String
  imagePublicId     String
  status            PlayerStatus     @default(UNSOLD)
  teamId            String?
  soldPrice         Int?
  email             String           @unique
  categoryId        String?
  category          PlayerCategory?  @relation(fields: [categoryId], references: [id])
  team              Team?            @relation(fields: [teamId], references: [id])
  positions         PlayerPosition[]
  wishlistedByTeams Team[]           @relation("TeamWishlist")
}

model PlayerPosition {
  id        String  @id @default(cuid())
  playerId  String
  position  String
  isPrimary Boolean
  player    Player  @relation(fields: [playerId], references: [id], onDelete: Cascade)
}

model AuctionLedgerEntry {
  id        String   @id @default(cuid())
  playerId  String
  teamId    String
  amount    Int
  createdAt DateTime @default(now())
}

model Fixture {
  id          String  @id @default(cuid())
  teamAId     String
  teamBId     String
  isTwoLegged Boolean
  venue       String
  matches     Match[]
}

model Match {
  id          String            @id @default(cuid())
  fixtureId   String
  legNumber   Int               @default(1)
  scoreA      Int?
  scoreB      Int?
  status      String
  scheduledAt DateTime
  fixture     Fixture           @relation(fields: [fixtureId], references: [id], onDelete: Cascade)
  stats       PlayerMatchStat[]
}

model PlayerMatchStat {
  id          String  @id @default(cuid())
  matchId     String
  playerId    String
  goals       Int     @default(0)
  assists     Int     @default(0)
  yellowCards Int     @default(0)
  redCards    Int     @default(0)
  cleanSheet  Boolean @default(false)
  match       Match   @relation(fields: [matchId], references: [id], onDelete: Cascade)
}

model News {
  id        String   @id @default(cuid())
  title     String
  body      String
  createdAt DateTime @default(now())
}

enum Role {
  SUPER_ADMIN
  PODIUM_ADMIN
  TEAM_MANAGER
  PLAYER
}

enum Phase {
  SETUP
  REGISTRATION
  AUCTION
  TOURNAMENT
}

enum PlayerStatus {
  UNSOLD
  SOLD
  WITHDRAWN
}

enum BidMode {
  NORMAL
  BLIND
}
